# ============================================
# Vartovii Trust Agent — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# Google AI Studio API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud Project ID (for Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# Google Cloud location for Vertex AI Gemini calls. Cloud Run itself still uses CLOUD_RUN_REGION.
GOOGLE_CLOUD_LOCATION=global

# Optional deployment regions
CLOUD_RUN_REGION=europe-west1
AGENT_ENGINE_REGION=europe-west1

# Public proof metadata shown by /api/readiness and the dashboard.
# These are safe public URLs/resource names, not credentials.
PUBLIC_HOSTED_URL=https://your-cloud-run-service-url.example.com
AGENT_ENGINE_RESOURCE_NAME=projects/your-project-number/locations/europe-west1/reasoningEngines/your-agent-engine-id
AGENT_ENGINE_CONSOLE_URL=https://console.cloud.google.com/vertex-ai/agents/agent-engines/locations/europe-west1/agent-engines/your-agent-engine-id/playground?project=your-project-number

# Model profile:
#   stable  = Gemini 3.5 Flash GA (recommended for production)
#   cost    = Gemini 3.1 Flash-Lite GA (high-volume / low-latency mode)
#   preview = Gemini 3.1 Pro preview for report tasks, explicit opt-in only
GEMINI_MODEL_PROFILE=stable

# Production deploy uses Vertex AI billing by default.
GOOGLE_GENAI_USE_VERTEXAI=true

# ADK feature flag
ADK_ENABLED=true

# ============================================
# MongoDB Atlas Configuration
# ============================================
# Connection string from MongoDB Atlas dashboard.
# Keep the real URI only in .env or Secret Manager, never in committed files.
MONGODB_CONNECTION_STRING=replace_with_mongodb_atlas_uri

# Database name (default: vartovii)
MONGODB_DATABASE=vartovii

# Set to false to use mock data instead of MongoDB
MONGODB_ENABLED=true

# Set to false for hosted runtimes that cannot launch the Node-based MCP child process.
# Cloud Run Dockerfile supports this by installing Node.js and mongodb-mcp-server.
MONGODB_MCP_ENABLED=true

# Agent Engine deploy defaults MCP off because the hosted ADK graph does not run
# the Cloud Run container's Node.js MCP child process.
AGENT_ENGINE_MCP_ENABLED=false

# ============================================
# Optional: Override individual model assignments
# ============================================
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# GEMINI_REPORT_MODEL=gemini-3.5-flash
# GEMINI_SENTIMENT_MODEL=gemini-3.5-flash
# GEMINI_ADK_MODEL=gemini-3.5-flash
