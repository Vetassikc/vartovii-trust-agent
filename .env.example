# ============================================
# Vartovii Trust Agent — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# Google AI Studio API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud Project ID (for Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# Model profile: "stable" (Gemini 2.5) or "preview" (Gemini 3.x)
GEMINI_MODEL_PROFILE=preview

# ADK feature flag
ADK_ENABLED=true

# ============================================
# MongoDB Atlas Configuration
# ============================================
# Connection string from MongoDB Atlas dashboard
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_CONNECTION_STRING=your_mongodb_connection_string_here

# Database name (default: vartovii)
MONGODB_DATABASE=vartovii

# Set to false to use mock data instead of MongoDB
MONGODB_ENABLED=true

# ============================================
# Optional: Override individual model assignments
# ============================================
# GEMINI_CHAT_MODEL=gemini-3-flash
# GEMINI_REPORT_MODEL=gemini-3-pro
# GEMINI_ADK_MODEL=gemini-3-flash
