# Google AI Studio API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Model profile: "stable" (Gemini 2.5) or "preview" (Gemini 3.x)
GEMINI_MODEL_PROFILE=stable

# ADK feature flag
ADK_ENABLED=true

# Optional: Override individual model assignments
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_REPORT_MODEL=gemini-2.5-pro
# GEMINI_ADK_MODEL=gemini-2.5-flash
